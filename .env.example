# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env is gitignored — never commit real keys.
# See README.md "Getting API keys" for how to obtain the two keys below.

# Tavily (web search). Free plan: 1,000 credits/month.
# Create one at https://app.tavily.com/ (dashboard -> API Keys).
TAVILY_API_KEY=tvly-dev-REPLACE_WITH_YOUR_TAVILY_KEY

# OpenRouter (preferred) — when set, all models route via OpenRouter.
# Create one at https://openrouter.ai/keys and top up $10+ for 1,000 free-model
# requests/day (otherwise :free models are limited to 50/day, 20/min).
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY_WITH_YOUR_OPENROUTER_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Global default model id, e.g. liquid/lfm-2.5-2.6b:free — per-role overrides below win.
MODEL=liquid/lfm-2.5-2.6b:free
# Optional per-role overrides (OpenRouter model ids):
# RESEARCH_MODEL=anthropic/claude-sonnet-4
# SUPERVISOR_MODEL=anthropic/claude-sonnet-4
# SCOPE_MODEL=openai/gpt-4.1
# SUMMARY_MODEL=openai/gpt-4.1-mini
# COMPRESS_MODEL=openai/gpt-4.1
# WRITER_MODEL=openai/gpt-4.1

# Optional ranking headers:
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=

# Legacy direct providers (only used when OPENROUTER_API_KEY is absent):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Speed knobs ---
# Per-call LLM timeout in seconds (fail fast instead of hanging):
MODEL_TIMEOUT=60
# Research depth caps (lower = faster, less thorough):
MAX_TOOL_ITERATIONS=4
MAX_RESEARCHER_ITERATIONS=4
MAX_CONCURRENT_RESEARCHERS=2
# Outbound LLM requests per minute (provider quota guard; 0 disables):
RATE_LIMIT_RPM=18
# Tavily: basic depth + snippet mode skips per-page summary LLM calls.
TAVILY_MAX_RESULTS=3
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_RAW=false
TAVILY_TIMEOUT=30
API_PORT=8000
UI_PORT=3000
